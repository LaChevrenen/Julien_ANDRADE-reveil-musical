{
  "Music": {
    "Providers": ["itunes", "musicbrainz"],
    "HttpTimeoutSeconds": 3,
    "CacheTtlMinutes": 60,
    "MusicBrainz": { "UserAgent": "ReveilMusical/1.0 (CONTACT_A_REMPLACER)" }
  },
  "Notification": { "DefaultChannel": "push", "FallbackOrder": ["push", "sms", "email"] },
  "Defaults": { "FallbackTrack": "Here Comes the Sun" },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
